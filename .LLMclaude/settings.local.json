{
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(mise:*)",
      "Bash(git:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(npx:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(psql:*)",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)"
    ]
  },
  "model": {
    "default": "claude-sonnet-4-20250514"
  },
  "project": {
    "name": "app-controle",
    "description": "Plataforma B2B de treinamento técnico corporativo",
    "defaultBranch": "desenvolvimento",
    "primaryRuntime": "bun",
    "currentSprint": {
      "number": 6,
      "name": "Demo B2B",
      "focus": "Autenticação, RBAC, Integração API",
      "roadmap": "docs/backlog/ROADMAP-DEMO-B2B.md"
    }
  },
  "filePatterns": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".git/**",
      "*.log"
    ]
  },
  "git": {
    "requireTestsForPR": true,
    "requireLintForPR": true,
    "commitConvention": "conventional",
    "coAuthor": "Claude <noreply@anthropic.com>"
  },
  "database": {
    "migrations": "database/migration-*.sql",
    "seeds": "database/seed-*.sql",
    "container": "app-controle-db",
    "credentials": {
      "user": "nocodb_user",
      "database": "app_controle"
    }
  }
}

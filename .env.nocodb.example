# ===============================
# NocoDB + PostgreSQL - Configuração
# app-controle MVP (1 curso - Bash)
# ===============================

# PostgreSQL
DB_PASSWORD=UltraThink_2026_Secure

# NocoDB JWT Secret (gerar com: openssl rand -hex 32)
JWT_SECRET=nocodb_jwt_secret_ultra_2026_change_me

# Admin Credentials (primeiro login no NocoDB)
ADMIN_EMAIL=admin@ultrathink.com
ADMIN_PASSWORD=UltraThink@Admin2026!

# pgAdmin (opcional - usar apenas com --profile tools)
PGADMIN_EMAIL=admin@ultrathink.com
PGADMIN_PASSWORD=UltraThink@Admin2026!

# ===============================
# INSTRUÇÕES DE USO
# ===============================

# 1. Copiar este arquivo para .env.nocodb
#    cp .env.nocodb.example .env.nocodb

# 2. Editar credenciais de segurança
#    nano .env.nocodb

# 3. Proteger arquivo
#    chmod 600 .env.nocodb

# 4. Iniciar serviços
#    source .env.nocodb
#    docker-compose -f docker-compose.nocodb.yml up -d

# 5. Acessar NocoDB
#    URL: http://localhost:8080
#    Email: admin@ultrathink.com
#    Senha: UltraThink@Admin2026!

# 6. Verificar dados carregados
#    docker exec -it app-controle-db psql -U nocodb_user -d app_controle -c "SELECT 'Empresas' AS tipo, COUNT(*) FROM companies UNION ALL SELECT 'Usuários', COUNT(*) FROM users UNION ALL SELECT 'Módulos', COUNT(*) FROM modules;"


{
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(mise:*)",
      "Bash(git:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(npx:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)"
    ]
  },
  "model": {
    "default": "claude-sonnet-4-20250514"
  },
  "project": {
    "name": "app-controle",
    "description": "Plataforma B2B de treinamento técnico corporativo",
    "defaultBranch": "desenvolvimento",
    "primaryRuntime": "bun"
  },
  "filePatterns": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".git/**",
      "*.log"
    ]
  },
  "git": {
    "requireTestsForPR": true,
    "requireLintForPR": true,
    "commitConvention": "conventional",
    "coAuthor": "Claude <noreply@anthropic.com>"
  }
}
